# SIAS Schedule Converter - Go Appwrite Function Environment Template

# Server Execution Port
PORT=5000

# Appwrite Cloud / Self-Hosted Configuration
APPWRITE_FUNCTION_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_FUNCTION_PROJECT_ID=your_appwrite_project_id
APPWRITE_FUNCTION_API_KEY=your_appwrite_api_key

# Security & CORS
ALLOWED_ORIGINS=*
MAX_FILE_SIZE_MB=16
CACHE_TIMEOUT_SECONDS=300
